# Database (SQLite default, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://username:password@localhost:5432/twitch_queue"

# Twitch OAuth Application (for user login)
TWITCH_CLIENT_ID="your_twitch_app_client_id"
TWITCH_CLIENT_SECRET="your_twitch_app_secret"
TWITCH_REDIRECT_URI="http://localhost:5000/api/auth/twitch/callback"

# Twitch Bot Configuration (for the bot account)
TWITCH_BOT_USERNAME="your_bot_username"
TWITCH_BOT_OAUTH_TOKEN="oauth:your_bot_token_here"

# YouTube API
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Authentication & Sessions
JWT_SECRET="your_super_secret_jwt_key_here"
SESSION_SECRET="your_session_secret_here"
JUDGE_TOKEN_SECRET="your_judge_token_secret_here"

# Server Configuration
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
TRUST_PROXY=1

# Admin
# Comma-separated Twitch user IDs granted admin access (e.g. "12345678,87654321").
# If left empty, NO users have admin access — there is no default admin.
ADMIN_TWITCH_IDS=""

# Ads announcements are driven by broadcaster login tokens captured during OAuth.

# Bot Settings (optional - can also be configured via database)
MAX_QUEUE_SIZE=50
SUBMISSION_COOLDOWN=30
MAX_VIDEO_DURATION=600
AUTO_PLAY_NEXT=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# LLM Chat Personality (optional)
# Any OpenAI-compatible API (OpenAI, Ollama, LM Studio, vLLM, OpenRouter...).
# When unset, the bot falls back to its built-in static chat messages.
# Examples: https://api.openai.com/v1 | http://localhost:11434/v1 (Ollama)
LLM_API_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# LLM_TIMEOUT_MS=8000
# LLM_TEMPERATURE=0.9
# LLM_MAX_TOKENS=200
# Override the built-in personality system prompt entirely:
# LLM_SYSTEM_PROMPT=""
